{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/process-viewer/artifacts-manifest.schema.json",
  "title": "Process Viewer artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "architecture",
        "relative_path",
        "file_version",
        "hash_algorithm",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "const": "bridge"
        },
        "architecture": {
          "enum": [
            "x86",
            "x64"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*\\.\\.).+$"
        },
        "file_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
