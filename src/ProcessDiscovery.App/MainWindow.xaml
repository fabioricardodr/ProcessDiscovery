<Window x:Class="ProcessDiscovery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcessDiscovery.Application.Presentation;assembly=ProcessDiscovery.Application"
        Title="Process Discovery"
        Height="720"
        Width="1200"
        MinHeight="480"
        MinWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Status da consulta"
                   Foreground="{DynamicResource ItauNavyBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="Nenhuma consulta executada." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Árvore de processos" Margin="0,0,6,0">
                <TreeView x:Name="ProcessTree"
                          SelectedItemChanged="ProcessTree_OnSelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AutomationProperties.Name="Árvore de processos">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:ProcessTreePresentationNode}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock>
                                <Run Text="PID " />
                                <Run Text="{Binding Pid, Mode=OneWay}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text=" (" />
                                <Run Text="{Binding StateText, Mode=OneWay}" />
                                <Run Text=")" />
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Processos" Margin="6,0,0,0">
                <DataGrid x:Name="ProcessTable"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectionChanged="ProcessTable_OnSelectionChanged"
                          AutomationProperties.Name="Tabela de processos">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="PPID" Binding="{Binding ParentPidText}" />
                        <DataGridTextColumn Header="Pai" Binding="{Binding ParentName}" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" />
                        <DataGridTextColumn Header="Caminho" Binding="{Binding ImagePath}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Detalhes do processo" Margin="0,10,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="PID: " FontWeight="SemiBold" />
                <TextBlock x:Name="DetailPidText" Grid.Row="0" Grid.Column="1" Text="Nenhum processo selecionado." />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Nome interno: " FontWeight="SemiBold" Margin="16,0,0,0" />
                <TextBlock x:Name="DetailInternalNameText" Grid.Row="0" Grid.Column="3" Text="-" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Identidade: " FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock x:Name="DetailIdentityText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Assinatura: " FontWeight="SemiBold" Margin="16,6,0,0" />
                <TextBlock x:Name="DetailSignatureText" Grid.Row="1" Grid.Column="3" Text="-" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Módulos: " FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock x:Name="DetailModulesText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Consistência: " FontWeight="SemiBold" Margin="16,6,0,0" />
                <TextBlock x:Name="DetailConsistencyText" Grid.Row="2" Grid.Column="3" Text="-" Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

    </Grid>
</Window>
