<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta visual inspirada no Itaú; não contém ativos de marca. -->
    <Color x:Key="ItauOrangeColor">#EC7000</Color>
    <Color x:Key="ItauOrangeDarkColor">#C85E00</Color>
    <Color x:Key="ItauNavyColor">#003B5C</Color>
    <Color x:Key="ItauNavyDarkColor">#00263A</Color>
    <Color x:Key="ItauInkColor">#1F2933</Color>
    <Color x:Key="ItauMutedInkColor">#52606D</Color>
    <Color x:Key="ItauCanvasColor">#F5F7F9</Color>
    <Color x:Key="ItauSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ItauBorderColor">#D9E2EC</Color>
    <Color x:Key="ItauFocusColor">#FFB566</Color>
    <Color x:Key="ItauErrorColor">#B42318</Color>

    <SolidColorBrush x:Key="ItauOrangeBrush" Color="{StaticResource ItauOrangeColor}" />
    <SolidColorBrush x:Key="ItauOrangeDarkBrush" Color="{StaticResource ItauOrangeDarkColor}" />
    <SolidColorBrush x:Key="ItauNavyBrush" Color="{StaticResource ItauNavyColor}" />
    <SolidColorBrush x:Key="ItauNavyDarkBrush" Color="{StaticResource ItauNavyDarkColor}" />
    <SolidColorBrush x:Key="ItauInkBrush" Color="{StaticResource ItauInkColor}" />
    <SolidColorBrush x:Key="ItauMutedInkBrush" Color="{StaticResource ItauMutedInkColor}" />
    <SolidColorBrush x:Key="ItauCanvasBrush" Color="{StaticResource ItauCanvasColor}" />
    <SolidColorBrush x:Key="ItauSurfaceBrush" Color="{StaticResource ItauSurfaceColor}" />
    <SolidColorBrush x:Key="ItauBorderBrush" Color="{StaticResource ItauBorderColor}" />
    <SolidColorBrush x:Key="ItauFocusBrush" Color="{StaticResource ItauFocusColor}" />
    <SolidColorBrush x:Key="ItauErrorBrush" Color="{StaticResource ItauErrorColor}" />

    <CornerRadius x:Key="ItauCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="ItauCardBorderThickness">1</Thickness>
</ResourceDictionary>
